# =============================================================================
# MEDIBOT Frontend Environment Configuration - EXAMPLE FILE
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control!

# =============================================================================
# REACT APP CONFIGURATION
# =============================================================================
# React environment variables must start with REACT_APP_

# =============================================================================
# GOOGLE CALENDAR INTEGRATION
# =============================================================================
# Google Calendar ID for embedded calendar display
# This should be the same calendar ID used in your backend service account
# Options:
# - "primary" for your main Google Calendar
# - Specific calendar ID (e.g., "abc123@group.calendar.google.com")
# - Service account calendar ID for dedicated MEDIBOT calendar
REACT_APP_GOOGLE_CALENDAR_ID=your_calendar_id_here@group.calendar.google.com

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Backend API base URL
# Development: Leave empty to use proxy from package.json
# Production: Set to your backend URL
REACT_APP_API_URL=https://medibot-ai-medical-assistant-platform.onrender.com

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Enable development features
# REACT_APP_DEBUG_MODE=true

# =============================================================================
# THEME & UI CONFIGURATION
# =============================================================================
# Default theme (light/dark)
# REACT_APP_DEFAULT_THEME=light

# Default language
# REACT_APP_DEFAULT_LANGUAGE=en

# =============================================================================
# CALENDAR DISPLAY SETTINGS
# =============================================================================
# Default calendar view mode (MONTH, WEEK, AGENDA)
# REACT_APP_DEFAULT_CALENDAR_MODE=MONTH

# Timezone for calendar display
# REACT_APP_TIMEZONE=Asia/Kolkata

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Update REACT_APP_GOOGLE_CALENDAR_ID with your actual calendar ID
# 3. Make sure the calendar ID matches the one used in your backend
# 4. For the embedded calendar to work:
#    - The calendar must be shared with your service account
#    - The calendar should be made public or properly shared
#    - Test the calendar embed URL manually in a browser

# =============================================================================
# GOOGLE CALENDAR SERVICE ACCOUNT SETUP NOTES
# =============================================================================
# For the calendar integration to work properly with a service account:
#
# 1. Create a dedicated Google Calendar for MEDIBOT appointments
# 2. Share this calendar with your service account email
# 3. Set the calendar ID in REACT_APP_GOOGLE_CALENDAR_ID
# 4. Make sure the calendar is set to "Public" or properly shared
#
# Calendar Sharing Steps:
# - Go to Google Calendar settings
# - Find your MEDIBOT calendar
# - Click "Settings and sharing"
# - Under "Share with specific people", add your service account email
# - Give it "Make changes to events" permission
# - Under "Access permissions", check "Make available to public" if needed
#
# Service Account Email Format:
# your-service-account@your-project-id.iam.gserviceaccount.com

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# Production URLs:
# - Frontend: https://medi-bot-ai-medical-assistant-platf.vercel.app
# - Backend: https://medibot-ai-medical-assistant-platform.onrender.com
#
# When deploying to production:
# 1. Ensure your calendar is properly configured and accessible
# 2. Test the calendar embed URL manually in a browser
# 3. Verify CORS settings if hosting on different domains
# 4. Consider using environment-specific calendar IDs for dev/staging/prod
# 5. Update REACT_APP_API_URL to point to your production backend

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit .env files to version control
# - Frontend environment variables are exposed to the browser
# - Only put non-sensitive configuration in REACT_APP_ variables
# - API keys should only be in the backend .env file
# - Use different calendar IDs for different environments if needed