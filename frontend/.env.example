# Frontend Environment Configuration

# API Configuration
REACT_APP_API_URL=http://localhost:3001

# Google Calendar Integration (Optional)
# If not set, calendar will use fallback display
# To get a calendar ID:
# 1. Go to Google Calendar settings
# 2. Find your calendar in the left sidebar
# 3. Click "Settings and sharing"
# 4. Copy the "Calendar ID" (looks like: abc123@group.calendar.google.com)
# 5. Make sure the calendar is public or shared appropriately
REACT_APP_GOOGLE_CALENDAR_ID=

# Example calendar IDs:
# For primary calendar: primary
# For shared calendar: your-calendar-id@group.calendar.google.com

# Development Settings
REACT_APP_DEBUG_MODE=false