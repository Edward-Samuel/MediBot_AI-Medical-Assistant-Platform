# =============================================================================
# MEDIBOT Environment Configuration - EXAMPLE FILE
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control!

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=3004

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# MongoDB connection string
# Local: mongodb://localhost:27017/medibot
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/medibot
MONGODB_URI=mongodb://localhost:27017/medibot

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
# JWT Secret - Use a strong, random string (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_long

# JWT Token expiration time
JWT_EXPIRE=24h

# =============================================================================
# AI SERVICES
# =============================================================================

# Google Gemini API Key (for appointment agent)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (for AI chat functionality)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API Key (for web search functionality)
# Get from: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# OpenAI API Key (some services may expect this)
# You can use the same key as OpenRouter or get from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# VECTOR DATABASE (PINECONE) - For FAQ System
# =============================================================================
# Pinecone API Key
# Get from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone Index Name
PINECONE_INDEX_NAME=medibot-faq

# =============================================================================
# TEXT-TO-SPEECH (ELEVENLABS)
# =============================================================================
# ElevenLabs API Key for voice synthesis
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# =============================================================================
# GOOGLE CALENDAR INTEGRATION
# =============================================================================
# Google Calendar ID (get from calendar settings)
# Use 'primary' for your main calendar or specific calendar ID
GOOGLE_CALENDAR_ID=your_calendar_id_here@group.calendar.google.com

# Timezone for calendar events
TIMEZONE=Asia/Kolkata

# Google OAuth Credentials (if using OAuth instead of service account)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Google Service Account Key (JSON as single line - for production)
# Alternative to google-credentials.json file
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# =============================================================================
# DEBUGGING & MONITORING
# =============================================================================
# Enable intent classifier debugging
DEBUG_INTENT_CLASSIFIER=false

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in all the API keys and configuration values
# 3. For Google Calendar integration:
#    - Create a Google Cloud Project
#    - Enable Google Calendar API
#    - Create a Service Account
#    - Download the JSON key file to backend/config/google-credentials.json
#    - Share your calendar with the service account email
# 4. For Pinecone setup:
#    - Create a Pinecone account and index
#    - Use dimension 768 for BioClinical ModernBERT embeddings
# 5. Test your configuration by running the application

# =============================================================================
# SECURITY NOTES
# =============================================================================
# - Never commit .env files to version control
# - Use strong, unique passwords and API keys
# - Rotate API keys regularly
# - Use environment-specific configurations for dev/staging/prod
# - Keep service account JSON files secure and never commit them