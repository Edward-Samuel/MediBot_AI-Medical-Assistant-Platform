# MEDIBOT Environment Configuration for Hugging Face Spaces

# Database - Use MongoDB Atlas for cloud deployment
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/medibot?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=7d

# Google APIs (Optional - for calendar integration)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-space-name-username.hf.space/auth/google/callback
GOOGLE_CALENDAR_ID=your-calendar-id

# OpenRouter API (Required for AI functionality)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Tavily Search API (Optional - for web search)
TAVILY_API_KEY=your-tavily-api-key

# ElevenLabs API (Optional - for text-to-speech)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Server Configuration
PORT=7860
NODE_ENV=production
TIMEZONE=Asia/Kolkata