              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientEmail\": \"patient1@medibot.com\",\n  \"testName\": \"Complete Blood Count\",\n  \"testType\": \"blood\",\n  \"results\": [\n    {\n      \"parameter\": \"WBC\",\n      \"value\": \"7.2\",\n      \"unit\": \"K/uL\",\n      \"referenceRange\": \"4.5-11.0\",\n      \"status\": \"normal\"\n    },\n    {\n      \"parameter\": \"RBC\",\n      \"value\": \"5.1\",\n      \"unit\": \"M/uL\",\n      \"referenceRange\": \"4.5-5.9\",\n      \"status\": \"normal\"\n    }\n  ],\n  \"performedAt\": \"LabCorp\",\n  \"notes\": \"Routine screening\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ehr/lab-results",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "lab-results"]
            }
          }
        },
        {
          "name": "Add Prescription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientEmail\": \"patient1@medibot.com\",\n  \"medicationName\": \"Lisinopril\",\n  \"genericName\": \"Lisinopril\",\n  \"dosage\": \"10 mg\",\n  \"route\": \"Oral\",\n  \"frequency\": \"Once daily\",\n  \"duration\": \"Ongoing\",\n  \"quantity\": 90,\n  \"refills\": 3,\n  \"pharmacy\": \"CVS Pharmacy\",\n  \"startDate\": \"2024-01-15\",\n  \"reason\": \"Hypertension\",\n  \"instructions\": \"Take in the morning with water\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ehr/prescriptions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "prescriptions"]
            }
          }
        },
        {
          "name": "Add Clinical Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientEmail\": \"patient1@medibot.com\",\n  \"noteType\": \"progress\",\n  \"chiefComplaint\": \"Follow-up for hypertension\",\n  \"historyOfPresentIllness\": \"Patient reports good adherence to medications. No side effects noted. Blood pressure readings at home have been stable.\",\n  \"physicalExamination\": \"BP 128/82, HR 72. Heart: Regular rate and rhythm. Lungs: Clear bilaterally.\",\n  \"assessment\": \"Hypertension well controlled on current regimen.\",\n  \"plan\": \"Continue current medications. Follow up in 3 months. Encouraged to maintain exercise routine.\",\n  \"followUpDate\": \"2025-04-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ehr/clinical-notes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "clinical-notes"]
