                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"relationship\": \"father\",\n  \"condition\": \"Coronary Artery Disease\",\n  \"ageOfOnset\": 58,\n  \"status\": \"living\",\n  \"notes\": \"Had stent placement at age 58\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ehr/family-history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "family-history"]
            }
          }
        }
      ]
    },
    {
      "name": "EHR - Doctor/Admin Endpoints",
      "item": [
        {
          "name": "Add Diagnosis",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
