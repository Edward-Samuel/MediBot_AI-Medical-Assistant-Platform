            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"allergen\": \"Shellfish\",\n  \"allergenType\": \"food\",\n  \"reaction\": \"Hives and difficulty breathing\",\n  \"severity\": \"severe\",\n  \"notes\": \"Avoid all shellfish\"\n}"
            },
            "url": {
