{
  "info": {
    "name": "MEDIBOT EHR API",
    "description": "Complete API collection for testing the EHR system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    console.log('Token saved:', jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient1@medibot.com\",\n  \"password\": \"your_password\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "EHR - Patient Endpoints",
      "item": [
        {
          "name": "Get My EHR",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ehr/my-ehr",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "my-ehr"]
            }
          }
        },
        {
          "name": "Get Holistic Analysis",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ehr/analysis",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "analysis"]
            }
          }
        },
        {
          "name": "Update Demographics",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateOfBirth\": \"1985-06-15\",\n  \"gender\": \"male\",\n  \"ethnicity\": \"Caucasian\",\n  \"maritalStatus\": \"married\",\n  \"occupation\": \"Software Engineer\",\n  \"address\": {\n    \"street\": \"123 Main Street\",\n    \"city\": \"San Francisco\",\n    \"state\": \"CA\",\n    \"zipCode\": \"94102\",\n    \"country\": \"USA\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ehr/demographics",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "demographics"]
            }
          }
        },
        {
          "name": "Add Vital Signs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodPressure\": {\n    \"systolic\": 120,\n    \"diastolic\": 80\n  },\n  \"heartRate\": 72,\n  \"temperature\": 36.8,\n  \"respiratoryRate\": 16,\n  \"oxygenSaturation\": 98,\n  \"weight\": 75,\n  \"height\": 175,\n  \"recordedBy\": \"Self\",\n  \"notes\": \"Morning reading\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ehr/vitals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "vitals"]
            }
          }
        },
        {
          "name": "Add Allergy",
