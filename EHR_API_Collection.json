              "raw": "{\n  \"patientEmail\": \"patient1@medibot.com\",\n  \"condition\": \"Hypertension\",\n  \"icdCode\": \"I10\",\n  \"severity\": \"moderate\",\n  \"status\": \"active\",\n  \"notes\": \"Stage 1 hypertension\",\n  \"treatmentPlan\": \"Lifestyle modifications and medication\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/ehr/diagnoses",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "diagnoses"]
