            },
            "url": {
              "raw": "{{baseUrl}}/api/ehr/social-history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ehr", "social-history"]
            }
          }
        },
        {
          "name": "Add Family History",
          "request": {
            "method": "POST",
